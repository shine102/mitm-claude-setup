[Unit]
Description=mitmproxy transparent proxy for Claude Code
After=network.target

[Service]
# Paths are filled in by setup.sh based on where the repo is cloned.
ExecStart=__VENV__/bin/mitmdump -s __SCRIPT__
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
